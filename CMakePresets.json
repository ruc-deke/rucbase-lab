{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "quality",
      "displayName": "Debug with strict warnings",
      "inherits": "debug",
      "cacheVariables": {
        "RUCBASE_STRICT_WARNINGS": "ON",
        "RUCBASE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "sanitizers",
      "displayName": "Debug with AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "debug",
      "cacheVariables": {
        "RUCBASE_ENABLE_ASAN": "ON",
        "RUCBASE_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "tsan",
      "displayName": "Debug with ThreadSanitizer",
      "inherits": "debug",
      "cacheVariables": {
        "RUCBASE_ENABLE_TSAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "quality",
      "configurePreset": "quality"
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "debug-client",
      "displayName": "Debug server + client only",
      "configurePreset": "debug",
      "targets": ["rmdb", "rucbase_client"]
    },
    {
      "name": "release-client",
      "displayName": "Release server + client only",
      "configurePreset": "release",
      "targets": ["rmdb", "rucbase_client"]
    }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "debug",
      "inherits": "test-base",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "inherits": "test-base",
      "configurePreset": "release"
    },
    {
      "name": "smoke",
      "inherits": "debug",
      "filter": {
        "include": {
          "label": "smoke"
        }
      }
    },
    {
      "name": "quality-smoke",
      "inherits": "test-base",
      "configurePreset": "quality",
      "filter": {
        "include": {
          "label": "smoke"
        }
      }
    },
    {
      "name": "sanitizers-smoke",
      "inherits": "test-base",
      "configurePreset": "sanitizers",
      "filter": {
        "include": {
          "label": "smoke"
        }
      }
    },
    {
      "name": "tsan-smoke",
      "inherits": "test-base",
      "configurePreset": "tsan",
      "filter": {
        "include": {
          "label": "smoke"
        }
      }
    },
    {
      "name": "framework",
      "inherits": "debug",
      "filter": {
        "include": {
          "label": "framework"
        }
      }
    },
    {
      "name": "unit",
      "inherits": "debug",
      "filter": {
        "include": {
          "label": "unit"
        }
      }
    },
    {
      "name": "lab1",
      "inherits": "debug",
      "filter": {
        "include": {
          "label": "lab1"
        }
      }
    },
    {
      "name": "lab2",
      "inherits": "debug",
      "filter": {
        "include": {
          "label": "lab2"
        }
      }
    },
    {
      "name": "lab3",
      "inherits": "debug",
      "filter": {
        "include": {
          "label": "lab3"
        }
      }
    },
    {
      "name": "lab3-query",
      "inherits": "debug",
      "filter": {
        "include": {
          "label": "query-suite"
        }
      }
    },
    {
      "name": "lab3-regress",
      "inherits": "debug",
      "filter": {
        "include": {
          "label": "regress-suite"
        }
      }
    },
    {
      "name": "lab4",
      "inherits": "debug",
      "filter": {
        "include": {
          "label": "lab4"
        },
        "exclude": {
          "label": "bonus"
        }
      }
    },
    {
      "name": "lab4-transaction",
      "inherits": "debug",
      "filter": {
        "include": {
          "label": "transaction-suite"
        },
        "exclude": {
          "label": "bonus"
        }
      }
    },
    {
      "name": "lab4-concurrency",
      "inherits": "debug",
      "filter": {
        "include": {
          "label": "concurrency-suite"
        },
        "exclude": {
          "label": "bonus"
        }
      }
    },
    {
      "name": "blackbox",
      "inherits": "debug",
      "filter": {
        "include": {
          "label": "blackbox"
        },
        "exclude": {
          "label": "bonus"
        }
      }
    },
    {
      "name": "bonus",
      "inherits": "debug",
      "filter": {
        "include": {
          "label": "bonus"
        }
      }
    }
  ]
}
